# Banco de dados
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
# Máximo de conexões simultâneas no pool compartilhado (padrão 10).
PGPOOL_MAX=10
# Pool reservado só para login/sessão (padrão 3) — evita timeout no PGStore.
PGSESSION_POOL_MAX=3
# intranet-api (chat): SERVICE_PROFILE=chat | Intranet principal: full ou omitir
SERVICE_PROFILE=full

# Omie
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_WEBHOOK_TOKEN=

# GitHub (se usado por integracoes internas)
# GitHub (merge/publicar PRs do Chatbot). Precisa poder fazer merge no repo.
# Classic: scope "repo". Fine-grained: Contents + Pull requests (Read and write) no Intranet.
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_OWNER=qualidafromtherm2
GITHUB_REPO=Intranet
GITHUB_PATH=imagens

# Armazenamento de arquivos — Cloudflare R2 (obrigatório)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=intranet-fromtherm
R2_PUBLIC_BASE_URL=https://pub-SEU_ID.r2.dev
STORAGE_BUCKET=produtos

# OpenAI (Assistente SGF — pago; não misturar com o orquestrador)
OPENAI_API_KEY=

# Orquestrador multi-IA (Chatbot admin) — IAs grátis na nuvem (sem Ollama)
# Cadastre as chaves no Render → Environment. Sem nenhuma chave, cai no Cursor.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Modelos opcionais (defaults sensatos se vazio)
# OPENROUTER_MODEL=openrouter/free   # NÃO use openrouter/auto (cobra o modelo escolhido)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_LIGHT_MODEL=llama-3.1-8b-instant   # reply / planner leve
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# MISTRAL_MODEL=mistral-small-latest
# Preferência do planner / worker (groq|gemini|openrouter|deepseek|mistral)
# IA_ORCHESTRATOR_PROVIDER=groq
# IA_FREE_WORKER_PROVIDER=groq
# IA_ORCHESTRATOR_LLM=1   # 0 = só heurística (sem gastar LLM no plano)
# Rate limit do chatbot (pedidos / janela)
# DEV_AGENT_RATE_MAX=20
# DEV_AGENT_RATE_WINDOW_MS=60000

# Cursor Cloud Agents (Agente Dev no chatbot — só admin)
# Gere em https://cursor.com/dashboard/api
CURSOR_API_KEY=
# Token opcional para o app Android / Cloud Agent falar com /api/dev-agent (header X-Dev-Agent-Token)
DEV_AGENT_MOBILE_TOKEN=
# URL pública da intranet (Render). Usada pelo Cloud Agent para /api/dev-agent/sql
# Ex.: https://intranet-30av.onrender.com
INTRANET_PUBLIC_URL=

# Chatbot — “Ver no site (teste)” = Service Preview do Render (PR)
# Pré-requisito (uma vez): Dashboard Render → serviço web da intranet → Previews →
#   Pull Request Previews = Manual
# O botão adiciona a label GitHub "render-preview" (ou [render preview] no título).
# Aviso: o preview copia as env vars do serviço (inclui DATABASE_URL de produção).
# Não precisa de variável extra — usa GITHUB_TOKEN já configurado.

# E-mail SMTP (devolução AT e futuros alertas)
# Preferir Hostinger (e-mail @fromtherm.com.br) — SPF/DKIM já no DNS Cloudflare.
# Hostinger SMTP (mesmo processo das reservas e do botão Devolução — evita spam).
# Conta dedicada de envio (devolução AT, reservas, alertas).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fromtherm.com.br
SMTP_PASS=
# Remetente deve ser o mesmo usuário SMTP (@fromtherm.com.br). Não use Gmail.
SMTP_FROM="Fromtherm Intranet <noreply@fromtherm.com.br>"
# Fallback opcional de destinatários (só se ninguém estiver ativo em AT → Destinatários de devolução)
AT_DEVOLUCAO_EMAILS=

# Opcional: forcar uso de DB em ambiente local
FORCE_DB=0

# Content-Security-Policy (protecao contra XSS/clickjacking)
# report  = so registra no log o que seria bloqueado (nao quebra nada) — padrao
# enforce = bloqueia de fato
# off     = desligado
CSP_MODE=report

# Google Sheets — registrar OP na aba PRODUÇÃO 2 - F/ ESCOPO (Apps Script)
GOOGLE_SHEETS_OP_WEBHOOK_URL=
